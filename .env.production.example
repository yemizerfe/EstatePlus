# Production stack settings — copy to .env and fill in the secrets.
# `docker compose up -d --build` then serves the app at http://localhost:8080

# Public URL of the site (used for CORS, OAuth callbacks and emailed links).
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Database (only reachable inside the compose network by default).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=realestate_db

# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional integrations — leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
