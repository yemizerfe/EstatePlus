// ─── Owner workspace: inquiries, viewings, documents ────────────────────────

enum InquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

/// A buyer/renter message about a listing, addressed to the listing owner.
model Inquiry {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId  String        @map("property_id") @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  senderId    String?       @map("sender_id") @db.Uuid
  name        String        @db.VarChar(150)
  email       String        @db.VarChar(255)
  phone       String?       @db.VarChar(40)
  message     String        @db.VarChar(2000)
  status      InquiryStatus @default(NEW)
  response    String?       @db.VarChar(2000)
  respondedAt DateTime?     @map("responded_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  owner       User          @relation("InquiryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sender      User?         @relation("InquirySender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([propertyId])
  @@index([createdAt(sort: Desc)])
  @@map("inquiries")
}

enum ViewingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A scheduled visit to one of the owner's listings.
model Viewing {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId  String        @map("property_id") @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  clientName  String        @map("client_name") @db.VarChar(150)
  clientEmail String        @map("client_email") @db.VarChar(255)
  clientPhone String?       @map("client_phone") @db.VarChar(40)
  scheduledAt DateTime      @map("scheduled_at")
  status      ViewingStatus @default(SCHEDULED)
  notes       String?       @db.VarChar(2000)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  owner       User          @relation("ViewingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([ownerId, scheduledAt])
  @@map("viewings")
}

/// A file the owner attached to their workspace (deed, contract, photo...).
/// Bytes live in the database so downloads survive without shared storage.
model PropertyDocument {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  name       String    @db.VarChar(255)
  category   String    @db.VarChar(60)
  mimeType   String    @map("mime_type") @db.VarChar(120)
  sizeBytes  Int       @map("size_bytes")
  data       Bytes
  createdAt  DateTime  @default(now()) @map("created_at")
  owner      User      @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([propertyId])
  @@map("property_documents")
}
